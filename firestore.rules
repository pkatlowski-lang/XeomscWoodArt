// Reguły Firestore dla systemu licencji Xeomsc-Laser (projekt xeomsc-licencje).
//
// To jest KOMPLETNY plik reguł — projekt xeomsc-licencje jest dedykowany
// tylko systemowi licencji, więc możesz skopiować całą zawartość poniżej
// i wkleić ją w konsoli Firebase:
//   Firestore Database -> Rules (Reguły) -> zaznacz wszystko, wklej, Publish.
//
// Kolekcje:
//  - licenses    — kody aktywacyjne programu.
//                   Dokument: licenses/{KOD}
//                     { status: "unused"|"activated", createdAt, note,
//                       activatedAt, deviceId }
//  - app_config  — konfiguracja/wersja programu.
//                   Dokument: app_config/latest
//                     { version, downloadUrl, notes, updatedAt }
//
// Panel admina (admin.html) loguje się przez Firebase Auth (e-mail/hasło).
// Program desktopowy loguje się anonimowo (signInAnonymously).
//
// Konfiguracja w konsoli Firebase (jednorazowo):
//  1) Authentication -> Sign-in method -> włącz "Email/Password".
//  2) Authentication -> Sign-in method -> włącz "Anonymous".
//  3) Authentication -> Users -> Dodaj użytkownika -> pkatlowski@gmail.com
//     (ustaw hasło). Weryfikacja e-maila NIE jest wymagana — administratorem
//     jest tylko konto o tym adresie (zabezpieczone hasłem), a adres jest
//     już zajęty, więc nikt inny go nie przejmie.
//  4) Firestore Database -> Reguły -> wklej całość poniżej -> Publish.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "pkatlowski@gmail.com";
    }

    function isAnon() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    match /licenses/{code} {
      allow get: if isAdmin() || isAnon();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      // Program desktopowy może oznaczyć nieużyty kod jako aktywowany na swoim
      // urządzeniu — ale nie może zmienić niczego innego.
      allow update: if isAdmin() || (
        isAnon()
        && resource.data.status == "unused"
        && request.resource.data.status == "activated"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "activatedAt", "deviceId"])
      );
    }

    match /app_config/{id} {
      // Odczyt publiczny — strona Downloads i sprawdzanie aktualizacji w
      // programie nie wymagają logowania.
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /portfolio_inquiries/{id} {
      function validInquiry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','email','message','date','status','read','mailboxId','replyKey','hasAttachment'])
          && (!('hasAttachment' in d) || (d.hasAttachment == true
            && existsAfter(/databases/$(database)/documents/portfolio_inquiries/$(id)/files/reference)))
          && id.matches('[a-f0-9-]{36}') && d.mailboxId == id
          && d.name is string && d.name.size() > 0 && d.name.size() <= 90
          && d.email is string && d.email.size() <= 180 && d.email.matches('.+@.+')
          && d.message is string && d.message.size() > 0 && d.message.size() <= 3500
          && d.replyKey is string && d.replyKey.matches('[A-Za-z0-9_-]{87}')
          && d.date == request.time && d.status == 'new' && d.read == false;
      }
      allow create: if isAnon() && validInquiry();
      allow get, list, update, delete: if isAdmin();

      match /files/reference {
        allow get, delete: if isAdmin();
        allow create: if isAnon()
          && !exists(/databases/$(database)/documents/portfolio_inquiries/$(id))
          && getAfter(/databases/$(database)/documents/portfolio_inquiries/$(id)).data.hasAttachment == true
          && request.resource.data.keys().hasOnly(['jpeg'])
          && request.resource.data.jpeg is bytes
          && request.resource.data.jpeg.size() > 0 && request.resource.data.jpeg.size() <= 350000;
      }

      // The private link decrypts a separate, random key for this thread.
      function dialogMatches(key) {
        return isAnon() && get(/databases/$(database)/documents/portfolio_inquiries/$(id)).data.dialogKey == key;
      }

      // Each notification must accompany a new post in the same atomic write.
      allow update: if isAnon() && resource.data.status != 'closed'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'lastClientId', 'lastClientAt'])
        && request.resource.data.read == false
        && request.resource.data.lastClientAt == request.time
        && request.resource.data.lastClientId.matches('[a-f0-9-]{36}')
        && !exists(/databases/$(database)/documents/portfolio_inquiries/$(id)/dialogs/$(resource.data.dialogKey)/messages/$(request.resource.data.lastClientId))
        && getAfter(/databases/$(database)/documents/portfolio_inquiries/$(id)/dialogs/$(resource.data.dialogKey)/messages/$(request.resource.data.lastClientId)).data.created == request.time;

      match /dialogs/{key}/messages/{post} {
        allow read: if isAdmin() || dialogMatches(key);
        allow delete: if isAdmin();
        allow create: if dialogMatches(key) && post.matches('[a-f0-9-]{36}')
          && get(/databases/$(database)/documents/portfolio_inquiries/$(id)).data.status != 'closed'
          && request.resource.data.keys().hasOnly(['body', 'created'])
          && request.resource.data.body is string && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 3500
          && request.resource.data.created == request.time
          && getAfter(/databases/$(database)/documents/portfolio_inquiries/$(id)).data.lastClientId == post
          && getAfter(/databases/$(database)/documents/portfolio_inquiries/$(id)).data.lastClientAt == request.time;
      }
    }

    // Wszystko inne — zablokowane.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
